-- Migration: 2026_08_28_dynamic_pricing.surql
--
-- AI Dynamic Pricing — demand-based price adjustment rules.
--
-- Research finding: Toast Dynamic Pricing $75+/mo, Square Intelligent
-- Pricing in higher tiers. POSR offers it free — analyzes demand patterns
-- (hour-of-day, day-of-week) + inventory levels + sales velocity and
-- generates pricing rules that integrate with the existing discount engine
-- (creates scheduled Discounts with automatic application).
--
-- Pricing strategies:
--   1. HAPPY_HOUR — low-demand hours get a % discount to drive traffic
--   2. SLOW_DAY   — slow weekdays (e.g. Monday) get promotional pricing
--   3. CLEARANCE  — overstocked + slow-moving items get clearance discount
--   4. PEAK_SURGE — high-demand hours: suppress existing discounts to
--                   maximize margin (recommendation only, no auto-action)
--   5. LUNCH_MENU — early lunch hours get lunch-special pricing
--   6. ITEM_PROMO — high-margin + low-popularity items get featured discount
--
-- Tables:
--   1. dynamic_pricing_rule — generated pricing rules (draft → active → expired)
--
-- Rule lifecycle:
--   draft (generated by AI) → manager reviews → active (creates Discount
--   record with schedule via existing discount engine) → expired
--
-- Safety constraints:
--   - Max discount % (default 30%)
--   - Never price below food cost × 1.5 (margin floor)
--   - Max active rules per strategy (default 5)
--   - Blackout dates (holidays) configurable

-- ---------------------------------------------------------------------------
-- dynamic_pricing_rule — generated pricing rules
-- ---------------------------------------------------------------------------
DEFINE TABLE IF NOT EXISTS dynamic_pricing_rule TYPE NORMAL SCHEMAFULL PERMISSIONS FULL;

DEFINE FIELD IF NOT EXISTS id              ON dynamic_pricing_rule TYPE string DEFAULT rand::ulid();
DEFINE FIELD IF NOT EXISTS name            ON dynamic_pricing_rule TYPE string;
DEFINE FIELD IF NOT EXISTS strategy        ON dynamic_pricing_rule TYPE string;
  -- 'happy_hour' | 'slow_day' | 'clearance' | 'peak_surge' | 'lunch_menu' | 'item_promo'
DEFINE FIELD IF NOT EXISTS description    ON dynamic_pricing_rule TYPE option<string>;
  -- What the rule does + why (max 300 chars)
DEFINE FIELD IF NOT EXISTS value_type      ON dynamic_pricing_rule TYPE string DEFAULT 'percent';
  -- 'percent' | 'fixed_amount' — matches DiscountValueType
DEFINE FIELD IF NOT EXISTS value          ON dynamic_pricing_rule TYPE float;
  -- Discount % (or fixed amount)
DEFINE FIELD IF NOT EXISTS target_item    ON dynamic_pricing_rule TYPE option<record<dish>>;
DEFINE FIELD IF NOT EXISTS target_item_id   ON dynamic_pricing_rule TYPE option<string>;
DEFINE FIELD IF NOT EXISTS target_category ON dynamic_pricing_rule TYPE option<record<category>>;
DEFINE FIELD IF NOT EXISTS target_category_id ON dynamic_pricing_rule TYPE option<string>;
  -- null = applies to all items (cart-wide)
DEFINE FIELD IF NOT EXISTS days_of_week    ON dynamic_pricing_rule TYPE option<array<int>>;
  -- 0=Sunday ... 6=Saturday; null = all days
DEFINE FIELD IF NOT EXISTS start_hour      ON dynamic_pricing_rule TYPE option<int>;
  -- 0-23
DEFINE FIELD IF NOT EXISTS end_hour        ON dynamic_pricing_rule TYPE option<int>;
  -- 0-23
DEFINE FIELD IF NOT EXISTS expected_impact ON dynamic_pricing_rule TYPE option<float>;
  -- Projected monthly revenue change (+/-)
DEFINE FIELD IF NOT EXISTS expected_traffic_lift ON dynamic_pricing_rule TYPE option<float>;
  -- Projected % increase in orders
DEFINE FIELD IF NOT EXISTS confidence      ON dynamic_pricing_rule TYPE float DEFAULT 0.7;
  -- 0-1
DEFINE FIELD IF NOT EXISTS ai_rationale    ON dynamic_pricing_rule TYPE option<string>;
  -- Why the AI suggests this (max 300 chars)
DEFINE FIELD IF NOT EXISTS status          ON dynamic_pricing_rule TYPE string DEFAULT 'draft';
  -- 'draft' | 'active' | 'expired' | 'rejected'
DEFINE FIELD IF NOT EXISTS linked_discount ON dynamic_pricing_rule TYPE option<record<discount>>;
  -- The Discount record created when activated (via existing engine)
DEFINE FIELD IF NOT EXISTS activated_at     ON dynamic_pricing_rule TYPE option<datetime>;
DEFINE FIELD IF NOT EXISTS activated_by     ON dynamic_pricing_rule TYPE option<record<user>>;
DEFINE FIELD IF NOT EXISTS expires_at      ON dynamic_pricing_rule TYPE option<datetime>;
  -- When the rule auto-expires (default: 30 days after activation)
DEFINE FIELD IF NOT EXISTS generated_at    ON dynamic_pricing_rule TYPE datetime DEFAULT time::now();

DEFINE INDEX IF NOT EXISTS idx_dpr_strategy    ON dynamic_pricing_rule FIELDS strategy;
DEFINE INDEX IF NOT EXISTS idx_dpr_status      ON dynamic_pricing_rule FIELDS status;
DEFINE INDEX IF NOT EXISTS idx_dpr_target_item ON dynamic_pricing_rule FIELDS target_item_id;

-- ---------------------------------------------------------------------------
-- Settings fields
-- ---------------------------------------------------------------------------
DEFINE FIELD IF NOT EXISTS dyn_price_max_discount_pct    ON settings TYPE option<float> DEFAULT 30;
  -- Safety: max discount % (default 30%)
DEFINE FIELD IF NOT EXISTS dyn_price_margin_floor_multiplier ON settings TYPE option<float> DEFAULT 1.5;
  -- Safety: never price below food_cost × this multiplier
DEFINE FIELD IF NOT EXISTS dyn_price_max_active_rules   ON settings TYPE option<int> DEFAULT 5;
  -- Safety: max active rules per strategy
DEFINE FIELD IF NOT EXISTS dyn_price_rule_duration_days ON settings TYPE option<int> DEFAULT 30;
  -- How long a rule stays active before auto-expiring
DEFINE FIELD IF NOT EXISTS dyn_price_ai_enabled          ON settings TYPE option<bool> DEFAULT true;
DEFINE FIELD IF NOT EXISTS dyn_price_lookback_days      ON settings TYPE option<int> DEFAULT 60;
  -- Historical data window for demand analysis
DEFINE FIELD IF NOT EXISTS dyn_price_min_hourly_orders   ON settings TYPE option<int> DEFAULT 4;
  -- An hour must have at least this many orders to be considered 'active'
