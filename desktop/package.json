{
  "name": "posr-desktop",
  "private": true,
  "version": "0.1.5",
  "type": "module",
  "scripts": {
    "dev": "node ./run-tauri.mjs dev",
    "build": "node ./run-tauri.mjs build --bundles deb",
    "build:linux": "node ./run-tauri.mjs build --bundles deb,appimage",
    "build:windows": "node ./run-tauri.mjs build --bundles nsis",
    "prepare:sidecars": "bash ./scripts/prepare-sidecars.sh",
    "tauri": "node ./run-tauri.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2"
  }
}
