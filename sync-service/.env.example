SYNC_SERVICE_HOST=0.0.0.0
SYNC_SERVICE_PORT=3136
SYNC_RECONNECT_MS=5000
SYNC_POLL_MS=1000
SYNC_BACKFILL_PAGE_SIZE=200
SYNC_CHANGE_LIMIT=100
SYNC_LOG_LEVEL=info

# Tenant / branch stamp written onto every uploaded master row as branch_id
SYNC_CLIENT_ID=client-001

# off | report_only | full
# - off: no sync (even if MASTER_URL is set)
# - report_only: upload sales only (default when MASTER_URL is set and this is unset)
# - full: upload sales + download FOH catalog
# SYNC_DISTRIBUTION_MODE=report_only

SYNC_SOURCE_URL=ws://surrealdb:8000/rpc
SYNC_SOURCE_NS=posr
SYNC_SOURCE_DB=posr
SYNC_SOURCE_USER=root
SYNC_SOURCE_PASS=root

SYNC_MASTER_URL=ws://master-surrealdb:8000/rpc
SYNC_MASTER_NS=posr_reporting
SYNC_MASTER_DB=posr_reporting
SYNC_MASTER_USER=root
SYNC_MASTER_PASS=root

# Optional: override the built-in sales upload allowlist (comma-separated).
# SYNC_INCLUDE_TABLES=order,order_item,order_payment

# Optional: override the built-in catalog download allowlist (full mode only).
# SYNC_DOWNLOAD_TABLES=menu_item,category,tax

# Optional: drop tables from upload and/or download lists
SYNC_EXCLUDE_TABLES=
# SYNC_DOWNLOAD_EXCLUDE_TABLES=

# Optional; when set, /stats and /catalog/sync-now require X-Sync-Stats-Secret
# SYNC_STATS_SECRET=

# Browser origins allowed to call /stats and /catalog/sync-now (Settings UI)
# SYNC_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
