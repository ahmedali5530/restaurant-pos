# For a brand-new empty ./database, these become the Surreal root user.
# If ./database already exists, they MUST match the user created on first start
# (older installs used root/root). Changing them later does not rotate the store.
SURREAL_USER=posr
SURREAL_PASS=posr-local-dev-change-me

# LOCAL DEV ONLY — shared by gateway, api, payment, print, and tracking.
# Hex only (no $). Compose interpolates $NAME in this file; a `$` in the secret
# becomes a missing-variable warning. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
GATEWAY_JWT_SECRET=13e14991c6724b218ce5e611684c28444f7ebc59c912b255bb69fbf692cac8deb379f1d01bcd48568d1ef437825873af

# Comma-separated allow-list of frontend origins. For LAN POS devices, add
# their origin (e.g. http://192.168.1.10:5173). Never set to "*" unless you
# intend the API to be callable from any website.
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
API_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
PAYMENT_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Auth gateway is on by default. SPA talks to the gateway (3142), not Surreal
# (8000). Do not set VITE_DB_USER / VITE_DB_PASS in this mode.
VITE_GATEWAY_AUTH=true
VITE_GATEWAY_URL=http://localhost:3142
# Rollback only: VITE_GATEWAY_AUTH=false plus VITE_DB_USER / VITE_DB_PASS and
# VITE_DB_WEBDOCKET pointing at Surreal (ws://localhost:8000).
# VITE_DB_USER=
# VITE_DB_PASS=

VITE_BASE_URL=localhost
VITE_DECIMAL_PLACES=0
# Primary ISO currency (HTG = Haitian gourde G, USD = $). Overridable in Settings.
VITE_LOCALE=fr-HT
VITE_DEFAULT_LANGUAGE=fr
VITE_APP_TIMEZONE=America/Port-au-Prince
VITE_CURRENCY=HTG
# Optional second row of quick tender chips at payment (e.g. USD when primary is HTG).
# VITE_SECONDARY_CURRENCY=USD
VITE_DB_WEBDOCKET=ws://localhost:3142
VITE_DATE_FORMAT=yyyy-MM-dd
VITE_TIME_FORMAT="HH:mm"
VITE_DATE_TIME_FORMAT="${VITE_DATE_FORMAT} ${VITE_TIME_FORMAT}"
VITE_DATE_HUMAN_FORMAT="ff"
VITE_DB_DATABASE_DATE_FORMAT="%Y-%m-%d"
VITE_DB_DATABASE_FORMAT="${VITE_DB_DATABASE_DATE_FORMAT} %H:%M"
VITE_PRINT_SERVER_URL=http://localhost:3132
VITE_PAYMENT_SERVER_URL=http://localhost:3134
VITE_PAYMENT_CALLBACK_SERVER_URL=https://posr.ahmedali5530.xyz:8434
VITE_TRACKING_SERVER_URL=http://localhost:3138
# In local DEV the SPA posts to same-origin /tracking (Vite proxy → 3138); this URL is used in production builds.
# Activity / order tracking posts. On by default; set false / 0 / no to disable.
VITE_TRACKING_ENABLED=true
# protectAction module checks: server (fresh DB fetch, default) or memory (Jotai user from login).
VITE_PROTECT_MODULES_SOURCE=server
VITE_API_SERVER_URL=http://localhost:3140
VITE_GOOGLE_MAPS_API_KEY=
# Max binary/image upload size in bytes. Default 500 KB if unset.
VITE_MAX_UPLOAD_BYTES=512000
# Max CSV import file size in bytes. Default 2 MB if unset.
VITE_MAX_CSV_UPLOAD_BYTES=2097152
# AI credentials live in api/.env.local (profiles). Do not add keys here.
# Optional override: force compact AI report prompts. Prefer AI_<PROFILE>_COMPACT
# on the API; set this to "true" only for a local frontend override.
VITE_AI_REPORT_COMPACT=false
VITE_GA4_ID=G-GD3G5YDS2F
VITE_RESTAURANT_NAME=
VITE_RESTAURANT_ADDRESS=
