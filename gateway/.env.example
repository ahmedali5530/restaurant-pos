# POSR auth gateway (server-only — never commit real secrets)

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3142
# Required, no default. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
GATEWAY_JWT_SECRET=
GATEWAY_JWT_TTL=12h
# Comma-separated frontend origins. Never "*" unless intentionally public.
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173

SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_NS=posr
SURREAL_DB=posr
# Required, no default — must match the SurrealDB instance's real credential.
SURREAL_USER=
SURREAL_PASS=
SURREAL_CONNECT_TIMEOUT_MS=10000
