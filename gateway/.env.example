# POSR auth gateway (server-only — never commit real secrets)

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3142
GATEWAY_JWT_SECRET=change-me-to-a-long-random-string
GATEWAY_JWT_TTL=12h
GATEWAY_ALLOWED_ORIGINS=*

SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_NS=posr
SURREAL_DB=posr
SURREAL_USER=root
SURREAL_PASS=root
SURREAL_CONNECT_TIMEOUT_MS=10000
