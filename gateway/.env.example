# POSR auth gateway (server-only — never commit real secrets)
# LOCAL DEV ONLY — copy to gateway/.env. Must match root .env for compose.

GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=3142
# Same value as root .env GATEWAY_JWT_SECRET. Change for production.
GATEWAY_JWT_SECRET=13e14991c6724b218ce5e611684c28444f7ebc59c912b255bb69fbf692cac8deb379f1d01bcd48568d1ef437825873af
GATEWAY_JWT_TTL=12h
# Comma-separated frontend origins. Never "*" unless intentionally public.
GATEWAY_ALLOWED_ORIGINS=http://localhost:5173

SURREAL_URL=ws://127.0.0.1:8000/rpc
SURREAL_NS=posr
SURREAL_DB=posr
# LOCAL DEV ONLY — must match SurrealDB and root .env.
SURREAL_USER=posr
SURREAL_PASS=posr-local-dev-change-me
SURREAL_CONNECT_TIMEOUT_MS=10000

# Terminal /sync/snapshot operational window (Surreal duration: 12h, 1d, 3d, …).
# Defaults keep cloud-friendly depth. On-prem LAN: prefer lean values below.
# POS_SNAPSHOT_OPERATIONAL_DURATION=3d
# POS_SNAPSHOT_COUPON_REDEMPTION_DURATION=90d
# On-prem example (shorter Dexie warmup; open checks always included):
# POS_SNAPSHOT_OPERATIONAL_DURATION=12h
# POS_SNAPSHOT_COUPON_REDEMPTION_DURATION=7d
