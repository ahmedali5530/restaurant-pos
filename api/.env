# Committed non-secret defaults. Do NOT put real credentials here.
# Put secrets (OPENAI_*) in api/.env.local, which is gitignored and overrides this file.

API_HOST=0.0.0.0
API_PORT=3140
API_LOG_LEVEL=info

# Comma separated allow-list for incoming frontend origins.
API_ALLOWED_ORIGINS=http://localhost:5173

# AI module (OpenAI / Azure OpenAI compatible). Leave blank here; set in .env.local.
OPENAI_API_KEY=
OPENAI_API_URL=
OPENAI_PROXY_URL=
OPENAI_MODEL=gpt-4o-mini
