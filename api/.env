# Committed non-secret defaults. Do NOT put real credentials here.
# Put AI profile secrets (AI_*_KEY / URLs) in api/.env.local (gitignored).

API_HOST=0.0.0.0
API_PORT=3140
API_LOG_LEVEL=info

# Comma separated allow-list for incoming frontend origins.
API_ALLOWED_ORIGINS=http://localhost:5173

# AI profiles + task routing — see api/.env.example. Configure in .env.local.
# Legacy OPENAI_* still works when AI_PROFILES is unset.
OPENAI_API_KEY=
OPENAI_API_URL=
OPENAI_PROXY_URL=
OPENAI_MODEL=gpt-4o-mini

# Integration encryption key — 32-byte hex string for AES-256-GCM OAuth token encryption.
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If unset, tokens are stored as plain text (not suitable for production).
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# QuickBooks Online OAuth (sandbox by default). Get these from developer.intuit.com.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=
QBO_ENV=sandbox
QBO_WEBHOOK_VERIFIER_TOKEN=
FRONTEND_ORIGIN=
