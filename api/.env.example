# General-purpose API service configuration.
# Copy this file to `.env` inside `api/`. All secrets stay server-side.

API_HOST=0.0.0.0
API_PORT=3140
API_LOG_LEVEL=info

# Comma separated allow-list for incoming frontend origins.
API_ALLOWED_ORIGINS=http://localhost:5173

# Session JWT (same secret as auth gateway / root .env). LOCAL DEV ONLY.
GATEWAY_JWT_SECRET=13e14991c6724b218ce5e611684c28444f7ebc59c912b255bb69fbf692cac8deb379f1d01bcd48568d1ef437825873af
# Sidecar routes require Authorization: Bearer <pos_session>. Set false only
# for emergency rollback (see docs/security/GATEWAY.md).
GATEWAY_AUTH_REQUIRED=true

# Must match SurrealDB / root .env. LOCAL DEV ONLY.
SURREAL_USER=posr
SURREAL_PASS=posr-local-dev-change-me

# ---------------------------------------------------------------------------
# Integrations module — encryption & OAuth provider config.
# ---------------------------------------------------------------------------

# Encryption key for OAuth tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty for development (tokens stored as plain text with a warning).
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# QuickBooks Online (sandbox by default). Get credentials from developer.intuit.com.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3140/integrations/qbo/oauth/callback
QBO_ENV=sandbox
QBO_WEBHOOK_VERIFIER_TOKEN=

# ---------------------------------------------------------------------------
# AI module — generic profiles + task routing. Server-side only.
# Put real URLs/keys/models in api/.env.local (gitignored). No vendor catalog
# in code: any OpenAI-compatible chat completions URL works.
# ---------------------------------------------------------------------------
#
# Named profiles (labels you choose). Comma-separated.
# AI_PROFILES=cheap,strong,vision
# AI_DEFAULT_PROFILE=cheap
#
# Task → profile map (app sends task; server picks the profile):
# AI_TASK_REPORTING=cheap
# AI_TASK_ANALYSIS=strong
# AI_TASK_FORECAST=strong
# AI_TASK_OCR=vision
#
# Vision/OCR profile is used by Smart Import (PDF/image extraction). Point it
# at a vision-capable model. The proxy also passes through optional
# response_format (e.g. { "type": "json_object" }) from the client.
# Per-profile settings (repeat for each name; hyphens become underscores):
# AI_CHEAP_URL=https://api.example.com/v1/chat/completions
# AI_CHEAP_KEY=
# AI_CHEAP_MODEL=
# AI_CHEAP_AUTH=bearer
# AI_CHEAP_COMPACT=true
# AI_CHEAP_PROXY_URL=
#
# AUTH: bearer (default) | api-key (Azure-style header) | none (local servers)
# COMPACT: true = frontend uses compact AI report prompts/tools for that profile
#
# Legacy single-profile fallback when AI_PROFILES is unset:
OPENAI_API_KEY=
OPENAI_API_URL=
OPENAI_PROXY_URL=
OPENAI_MODEL=gpt-4o-mini

# AI usage limits (VPS / shared-key installs). Leave unset for unlimited
# (typical for local installs where the customer provides their own key).
# AI_ENABLED=false hard-blocks all AI (403). Limits count each
# POST /ai/chat/completions call (UTC day / calendar month).
AI_ENABLED=true
AI_DAILY_LIMIT=
AI_MONTHLY_LIMIT=
