# General-purpose API service configuration.
# Copy this file to `.env` inside `api/`. All secrets stay server-side.

API_HOST=0.0.0.0
API_PORT=3140
API_LOG_LEVEL=info

# Comma separated allow-list for incoming frontend origins.
API_ALLOWED_ORIGINS=http://localhost:5173

# Session JWT (same secret as auth gateway). When GATEWAY_AUTH_REQUIRED=true,
# module routes require Authorization: Bearer <pos_session>.
GATEWAY_JWT_SECRET=
GATEWAY_AUTH_REQUIRED=false

# ---------------------------------------------------------------------------
# Integrations module — encryption & OAuth provider config.
# ---------------------------------------------------------------------------

# Encryption key for OAuth tokens at rest (AES-256-GCM).
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Leave empty for development (tokens stored as plain text with a warning).
INTEGRATION_TOKEN_ENCRYPTION_KEY=

# QuickBooks Online (sandbox by default). Get credentials from developer.intuit.com.
QBO_CLIENT_ID=
QBO_CLIENT_SECRET=
QBO_REDIRECT_URI=http://localhost:3140/integrations/qbo/oauth/callback
QBO_ENV=sandbox
QBO_WEBHOOK_VERIFIER_TOKEN=

# ---------------------------------------------------------------------------
# AI module (OpenAI / Azure OpenAI compatible). Server-side only.
# These used to live in the frontend .env as VITE_OPENAI_* and leaked into the
# client bundle. They now live here and never reach the browser.
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
OPENAI_API_URL=
# Optional proxy URL that takes precedence over OPENAI_API_URL.
OPENAI_PROXY_URL=
OPENAI_MODEL=gpt-4o-mini

# AI usage limits (VPS / shared-key installs). Leave unset for unlimited
# (typical for local installs where the customer provides their own key).
# AI_ENABLED=false hard-blocks all AI (403). Limits count each
# POST /ai/chat/completions call (UTC day / calendar month).
AI_ENABLED=true
AI_DAILY_LIMIT=
AI_MONTHLY_LIMIT=
