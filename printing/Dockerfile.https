# Standalone HTTPS image: Node print server + Caddy TLS reverse proxy
FROM node:20-alpine

# libudev.so.1 required by node_modules/usb for USB access.
# canvas.node is dynamically linked; these libs must exist at runtime
# (libcairo.so.2, pango, libpng, libjpeg.so.8, giflib), not only at build time.
RUN apk add --no-cache \
  eudev-libs \
  build-base python3 pkgconf \
  cairo cairo-dev \
  pango pango-dev \
  libpng \
  libjpeg-turbo jpeg-dev \
  giflib giflib-dev \
  freetype glib pixman harfbuzz \
  fontconfig ttf-dejavu font-noto font-noto-arabic \
  caddy

WORKDIR /app

ENV PRINT_PORT=3132
ENV PRINT_HOST=127.0.0.1
ENV TLS_CERT=/certs/localhost.pem
ENV TLS_KEY=/certs/localhost-key.pem

EXPOSE 443

COPY package*.json ./
RUN npm install

COPY . .

RUN chmod +x docker-entrypoint-https.sh

ENTRYPOINT ["/app/docker-entrypoint-https.sh"]
