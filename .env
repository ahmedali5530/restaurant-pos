# Required — SurrealDB root credential, used by docker-compose to start
# SurrealDB and by every backend service to connect to it. No default: a
# fresh `docker compose up` fails loudly until these are set to real,
# non-guessable values (not "root"/"root").
SURREAL_USER=
SURREAL_PASS=

# Required — long random secret used to sign/verify gateway session JWTs.
# No default. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
GATEWAY_JWT_SECRET=

# Comma-separated allow-list of frontend origins allowed to call the gateway/
# API/payment/tracking/printer services. Defaults to http://localhost:5173
# (this repo's own dev frontend) if left unset here — set this explicitly for
# any other/production origin. Never set to "*" unless you intend the API to
# be callable from any website.
# GATEWAY_ALLOWED_ORIGINS=http://localhost:5173
# API_ALLOWED_ORIGINS=http://localhost:5173
# PAYMENT_ALLOWED_ORIGINS=http://localhost:5173

# Optional — only needed if VITE_GATEWAY_AUTH is explicitly turned on/off from
# its current legacy-mode default. Legacy mode (VITE_GATEWAY_AUTH unset/off)
# connects straight from the browser to SurrealDB using these; no default
# credential ships in the client bundle, so legacy mode requires setting them.
# VITE_GATEWAY_AUTH=true
# VITE_DB_USER=
# VITE_DB_PASS=

VITE_BASE_URL=localhost
VITE_DECIMAL_PLACES=0
VITE_LOCALE=en-PK
VITE_DEFAULT_LANGUAGE=en
VITE_APP_TIMEZONE=Asia/Karachi
VITE_CURRENCY=PKR
VITE_DB_WEBDOCKET=ws://localhost:8000
VITE_DATE_FORMAT=yyyy-MM-dd
VITE_TIME_FORMAT="HH:mm"
VITE_DATE_TIME_FORMAT="${VITE_DATE_FORMAT} ${VITE_TIME_FORMAT}"
VITE_DATE_HUMAN_FORMAT="ff"
VITE_DB_DATABASE_DATE_FORMAT="%Y-%m-%d"
VITE_DB_DATABASE_FORMAT="${VITE_DB_DATABASE_DATE_FORMAT} %H:%M"
VITE_PRINT_SERVER_URL=http://localhost:3132
VITE_PAYMENT_SERVER_URL=http://localhost:3134
VITE_PAYMENT_CALLBACK_SERVER_URL=https://posr.ahmedali5530.xyz:8434
VITE_TRACKING_SERVER_URL=http://localhost:3138
VITE_API_SERVER_URL=http://localhost:3140
VITE_GOOGLE_MAPS_API_KEY=
# Max binary/image upload size in bytes. Default 500 KB if unset.
VITE_MAX_UPLOAD_BYTES=512000
# Max CSV import file size in bytes. Default 2 MB if unset.
VITE_MAX_CSV_UPLOAD_BYTES=2097152
# AI credentials live in api/.env.local (profiles). Do not add keys here.
# Optional override: force compact AI report prompts. Prefer AI_<PROFILE>_COMPACT
# on the API; set this to "true" only for a local frontend override.
VITE_AI_REPORT_COMPACT=false
VITE_GA4_ID=G-GD3G5YDS2F
VITE_RESTAURANT_NAME=
VITE_RESTAURANT_ADDRESS=