      "title": "Payment types",
      "steps": [
        "Open the Payment types tab.",
        "Define Cash, Card, and custom tenders shown on the payment screen.",
        "Set sort order and whether a type requires reference or change calculation."
      ],
      "image": "admin-payments-types.png",
      "caption": "Payment types tab."
    },
    {
      "id": "taxes",
      "title": "Taxes",
      "intro": "Taxes apply to dishes and appear on receipts and reports.",
      "steps": [
        "Open the Taxes tab.",
        "Create tax rates and link them to applicable items or order types.",
        "Save so new orders calculate tax correctly."
      ],
      "image": "admin-payments-taxes.png",
      "caption": "Taxes tab."
    },
    {
      "id": "order-types",
      "title": "Order types",
      "steps": [
        "Open the Order types tab.",
        "Configure dine-in, takeaway, delivery, and other service modes.",
        "Order types drive kitchen routing, reporting, and default behaviors."
      ],
      "image": "admin-payments-order-types.png",
      "caption": "Order types tab."
    },
    {
      "id": "extras",
      "title": "Extras",
      "intro": "Extras are automatic surcharges linked to payment types, order types, or tables (e.g. service fees or cover charges).",
      "steps": [
        "Open the Extras tab.",
        "Create extras with name, amount, and applicability rules.",
        "Save so qualifying orders include the surcharge on payment."
      ],
      "image": "admin-extras.png",
      "caption": "Extras tab."
    },
